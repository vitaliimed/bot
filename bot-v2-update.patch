@@ -0,0 +1,60 @@
+"""Local, deterministic branded JPEG cards. No AI or external image service."""
+import io
+import os
+from PIL import Image,ImageDraw,ImageFont
+from zoneinfo import ZoneInfo
+from .sources import clean
+
+PALETTES={'news':('#101C36','#4D97FF'),'sport':('#13332D','#73E2B1'),'events':('#302047','#F4B860')}
+LABELS={'news':'НОВИНИ ФІНЛЯНДІЇ','sport':'СПОРТ','events':'ПОДІЇ · UUSIMAA'}
+
+def font(size,bold=False):
+    name='DejaVuSans-Bold.ttf' if bold else 'DejaVuSans.ttf'
+    for root in ('/usr/share/fonts/truetype/dejavu','/usr/share/fonts/dejavu'):
+        path=os.path.join(root,name)
+        if os.path.exists(path): return ImageFont.truetype(path,size)
+    raise RuntimeError('Template font missing; install fonts-dejavu-core')
+
+def wrap(draw,text,face,width,max_lines):
+    lines=[];line=''
+    for word in text.split():
+        while draw.textlength(word,font=face)>width:
+            cut=len(word)-1
+            while cut>1 and draw.textlength(word[:cut],font=face)>width: cut-=1
+            if line: lines.append(line);line=''
+            lines.append(word[:cut]);word=word[cut:]
+        test=(line+' '+word).strip()
+        if draw.textlength(test,font=face)>width:
+            lines.append(line);line=word
+        else: line=test
+    if line: lines.append(line)
+    if len(lines)>max_lines:
+        lines=lines[:max_lines];last=lines[-1]
+        while last and draw.textlength(last+'…',font=face)>width:last=last[:-1]
+        lines[-1]=last+'…'
+    return lines
+
+def create(item,tag,style='auto',logo=None):
+    category=style if style in PALETTES else 'events' if item.get('category')=='events' else 'sport' if item.get('category')=='sport' else 'news'
+    background,accent=PALETTES[category]
+    canvas=Image.new('RGB',(1200,675),background);draw=ImageDraw.Draw(canvas)
+    draw.rounded_rectangle((45,42,1155,633),radius=24,outline=accent,width=2)
+    draw.rounded_rectangle((75,77,87,121),radius=6,fill=accent)
+    draw.text((108,80),LABELS[category],font=font(26,True),fill=accent)
+    title=clean(item.get('title') or 'Фінляндія',300)
+    size=54 if len(title)<85 else 44
+    face=font(size,True)
+    for n,line in enumerate(wrap(draw,title,face,1010,5)):
+        draw.text((78,163+n*(size+12)),line,font=face,fill='white')
+    event=item.get('event',{});parts=[]
+    if event.get('start'):
+        parts.append(event['start'].astimezone(ZoneInfo('Europe/Helsinki')).strftime('%d.%m.%Y' if event.get('date_only') else '%d.%m.%Y · %H:%M'))
+    if event.get('city'):parts.append(clean(event['city'],40))
+    if parts: draw.text((78,531),'  |  '.join(parts),font=font(25),fill=accent)
+    draw.text((78,587),clean(tag,60),font=font(22,True),fill='white')
+    draw.text((836,587),'ІНФОРМАЦІЙНА КАРТКА',font=font(17),fill='#B9C4D6')
+    if logo:
+        with Image.open(io.BytesIO(logo)) as original:
+            mark=original.convert('RGBA');mark.thumbnail((115,60));canvas.paste(mark,(1020,66),mark)
+    output=io.BytesIO();canvas.save(output,'JPEG',quality=86,optimize=True)
+    return {'image_bytes':output.getvalue(),'image_kind':'template','image_provider':'local','image_error':''}
diff --git a/app/usage.py b/app/usage.py
new file mode 100644
index 0000000..3b79c17
--- /dev/null
+++ b/app/usage.py
@@ -0,0 +1,49 @@
+"""Persistent attempt quotas and explicit free/paid routing, shared across instances."""
+import asyncio
+import math
+import secrets
+from datetime import datetime,timezone
+from google.cloud import firestore
+
+database=None
+
+class BudgetBlocked(ValueError): pass
+
+def allowed(provider,model,cfg):
+    if provider in cfg.get('disabled_ai',[]): return False
+    mode=cfg.get('cost_mode','free')
+    if mode=='off': return False
+    if mode=='paid': return True
+    # Explicit free model routing; never fall back to a paid OpenRouter model.
+    if provider=='openrouter': return model=='openrouter/free' or model.endswith(':free')
+    # Cloudflare is permitted only after the owner confirms Workers Free in its dashboard.
+    return provider=='cloudflare' and cfg.get('cloudflare_free_account') is True
+
+async def reserve(provider,model,cfg,task='text'):
+    if not allowed(provider,model,cfg): raise BudgetBlocked('Провайдер/модель запрещены текущим режимом расходов')
+    if database is None: return None
+    current=datetime.now(timezone.utc);route=cfg.get('_route','news')
+    refs=[database.collection('ai_usage').document(route+'-'+current.strftime(fmt)) for fmt in ('%Y-%m-%d','%Y-%m')]
+    @firestore.transactional
+    def claim(tx):
+        values=[r.get(transaction=tx).to_dict() or {} for r in refs]
+        for value,limit in zip(values,(cfg['ai_daily_limit'],cfg['ai_monthly_limit'])):
+            if value.get('attempts',0)>=limit: raise BudgetBlocked('Лимит запросов ИИ исчерпан')
+        for ref,value in zip(refs,values):
+            tx.set(ref,dict(value,attempts=value.get('attempts',0)+1,updated_at=current))
+    await asyncio.to_thread(claim,database.transaction())
+    identity=secrets.token_hex(12)
+    await asyncio.to_thread(database.collection('ai_requests').document(identity).set,
+        {'at':current,'route':route,'provider':provider,'model':model,'task':task,'status':'started','cost':None})
+    return identity
+
+async def finish(identity,status,usage=None,code=None):
+    if not database or not identity:return
+    value={'status':status,'finished_at':datetime.now(timezone.utc)}
+    if code is not None: value['code']=str(code)[:30]
+    usage=usage or {}
+    for key in ('prompt_tokens','completion_tokens','total_tokens'):
+        if type(usage.get(key)) is int:value[key]=usage[key]
+    if isinstance(usage.get('cost'),(int,float)) and math.isfinite(usage['cost']) and usage['cost']>=0:
+        value.update(cost=float(usage['cost']),cost_source='provider',currency='USD')
+    await asyncio.to_thread(database.collection('ai_requests').document(identity).update,value)
