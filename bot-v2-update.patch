+            sid=hashlib.sha256((bot.ROUTE.get()+parts[1]).encode()).hexdigest()[:20]
+            cfg=await bot.editor_config();value={'name':parts[0][:80],'url':parts[1],'kind':parts[2],'route':bot.ROUTE.get(),
